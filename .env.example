# Copy to .env and adjust as needed: `cp .env.example .env`.
# docker compose reads .env automatically; shell env vars override it.
# All values below are the built-in defaults — the file documents the knobs.

# Pinned image version. Bump deliberately; see https://hub.docker.com/r/wiktorn/overpass-api/tags
OVERPASS_IMAGE_TAG=v0.7.62.9

# Host port for the API. Endpoint becomes http://localhost:${OVERPASS_PORT}/api/interpreter
OVERPASS_PORT=12345

# --- Data source (keep extract and diff feed in the same region) ---
# Whole North America (~17.9 GB extract, ~40-70 GB DB once imported):
OVERPASS_PLANET_URL=https://download.geofabrik.de/north-america-latest.osm.pbf
OVERPASS_DIFF_URL=https://download.geofabrik.de/north-america-updates/

# US only (~11 GB extract) — matches the original issue #2 scope:
#   OVERPASS_PLANET_URL=https://download.geofabrik.de/north-america/us-latest.osm.pbf
#   OVERPASS_DIFF_URL=https://download.geofabrik.de/north-america/us-updates/

# Tiny extract for a fast end-to-end smoke test (~17 MB, imports in ~1-2 min):
#   OVERPASS_PLANET_URL=https://download.geofabrik.de/north-america/us/district-of-columbia-latest.osm.pbf
#   OVERPASS_DIFF_URL=https://download.geofabrik.de/north-america/us/district-of-columbia-updates/

# --- Import / behavior ---
OVERPASS_MODE=init          # init (build from extract) | clone (copy a seeded DB)
OVERPASS_META=no            # no (current state only) | attic (time-travel, far larger)
OVERPASS_COMPRESSION=gz     # no | gz | lz4
OVERPASS_USE_AREAS=false    # true enables is_in()/area{} queries; ~doubles import time
OVERPASS_RULES_LOAD=10      # area-generation load (only relevant when areas are on)
OVERPASS_UPDATE_SLEEP=86400 # seconds between diff passes; 86400 = daily
